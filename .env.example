# Schwab Developer Portal (developer.schwab.com) — Individual access app
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:3000/schwab/callback

# console.anthropic.com — used server-side only, never sent to the browser
ANTHROPIC_API_KEY=

# dashboard.plaid.com — multi-tenant account linking (any bank/brokerage,
# unlike Schwab's Individual-only tier). Start in "sandbox" for free/instant
# testing; "production" requires Plaid's own review before real bank data.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Any free Postgres works: Supabase, Neon, Railway, or local Postgres
DATABASE_URL=postgres://user:password@localhost:5432/cardinal_personal

# Any long random string, used to sign session cookies
SESSION_SECRET=change-me-to-something-random

# 32-byte hex key used to encrypt Schwab tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/rotating this locks out every stored Schwab connection — affected
# users just click "Connect Schwab" again, nothing else is lost.
TOKEN_ENCRYPTION_KEY=

PORT=3000
